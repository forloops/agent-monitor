#!/usr/bin/env python3
"""Codex lifecycle hooks -> iTerm2 session status.

Pushes Codex agent state into the same per-session status store that
iTerm2's cc-status uses for Claude Code, so the AgentMonitor menu bar
app (and iTerm2's own UI) shows Codex sessions too.

Registered in ~/.codex/hooks.json. Receives the hook payload as JSON on
stdin; never blocks anything (no stdout, always exits 0).
"""
import json
import os
import shutil
import subprocess
import sys
import time

IT2 = next(
    (p for p in (
        "/Applications/iTerm.app/Contents/Resources/utilities/it2",
        os.path.expanduser("~/Applications/iTerm.app/Contents/Resources/utilities/it2"),
    ) if os.path.exists(p)),
    None,
) or shutil.which("it2")
LOG = "/tmp/agent-monitor-codex.log"

STATUS = {
    "SessionStart": "idle",
    "UserPromptSubmit": "working",
    "PreToolUse": "working",
    "PostToolUse": "working",
    "PreCompact": "working",
    "PostCompact": "working",
    "PermissionRequest": "waiting",
    "Stop": "done",
    "Interrupt": "idle",
    "SessionEnd": "idle",
}


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write("%s %s\n" % (time.strftime("%H:%M:%S"), msg))
    except OSError:
        pass


def main():
    raw = sys.stdin.read()
    try:
        event = json.loads(raw).get("hook_event_name", "")
    except Exception as e:
        log("PARSE ERROR %r raw=%r" % (e, raw[:200]))
        return
    session = os.environ.get("ITERM_SESSION_ID", "").split(":")[-1]
    status = STATUS.get(event)
    log("%s -> %s (session=%s)" % (event, status, session or "none"))
    if not session or not status or not IT2:
        return
    try:
        subprocess.run(
            [IT2, "session", "set-status", "-s", session,
             "--status", status, "--detail", "codex", "--quiet-if-unresolved"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10,
        )
    except Exception:
        pass


if __name__ == "__main__":
    main()
    sys.exit(0)
