#!/usr/bin/env python3
"""Claude Code / Codex lifecycle hook -> AgentMonitor session store.

Usage (registered by install.sh):  agent-status claude | agent-status codex

Receives the hook payload as JSON on stdin and writes one JSON file per agent
session to ~/.agent-monitor/sessions/, recording the status plus everything
the menu bar app needs to show and focus the session in any terminal:

  {"agent": "claude", "status": "working", "cwd": ..., "pid": <agent pid>,
   "tty": "/dev/ttys003", "updated": <epoch>, "terminal": {...env identity...}}

The app treats a record as live while `pid` is running. SessionEnd deletes it.

For Codex inside iTerm2 the status is additionally pushed to iTerm2's own
status store (so iTerm2's UI shows it too); Claude Code already gets that
from iTerm2's bundled cc-status hook.

Never blocks the agent: no stdout, always exits 0.
"""
import json
import os
import shutil
import subprocess
import sys
import time

STORE = os.path.expanduser("~/.agent-monitor/sessions")
LOG = "/tmp/agent-monitor-hook.log"

# event -> status; events not listed leave the status untouched.
STATUS = {
    "claude": {
        "SessionStart": "idle",
        "UserPromptSubmit": "working",
        "PreToolUse": "working",
        "PostToolUse": "working",
        "PreCompact": "working",
        "PermissionRequest": "waiting",
        "Stop": "done",
        "StopFailure": "error",
        "SessionEnd": None,            # record removed
    },
    "codex": {
        "SessionStart": "idle",
        "UserPromptSubmit": "working",
        "PreToolUse": "working",
        "PostToolUse": "working",
        "PreCompact": "working",
        "PostCompact": "working",
        "PermissionRequest": "waiting",
        "Stop": "done",
        "Interrupt": "idle",
        "SessionEnd": None,
    },
}
# Claude Code's Notification event carries the real signal in notification_type.
CLAUDE_NOTIFICATION = {"permission_prompt": "waiting", "idle_prompt": "idle",
                       "elicitation_dialog": "waiting"}

IT2 = next(
    (p for p in (
        "/Applications/iTerm.app/Contents/Resources/utilities/it2",
        os.path.expanduser("~/Applications/iTerm.app/Contents/Resources/utilities/it2"),
    ) if os.path.exists(p)),
    None,
) or shutil.which("it2")


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write("%s %s\n" % (time.strftime("%H:%M:%S"), msg))
    except OSError:
        pass


def agent_process(agent):
    """(pid, tty) of the agent that spawned this hook, found by walking up the
    process tree until a command named like the agent. Falls back to the
    parent pid, which is still usually right."""
    try:
        out = subprocess.run(["ps", "-axo", "pid=,ppid=,tty=,comm="],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return os.getppid(), None
    procs = {}
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4:
            procs[int(parts[0])] = (int(parts[1]), parts[2], parts[3])
    pid = os.getppid()
    fallback = pid
    for _ in range(8):
        info = procs.get(pid)
        if not info:
            break
        ppid, tty, comm = info
        if agent in os.path.basename(comm).lower():
            return pid, tty
        pid = ppid
        if pid <= 1:
            break
    info = procs.get(fallback)
    return fallback, (info[1] if info else None)


def terminal_identity():
    env = os.environ.get
    ident = {
        "bundle_id": env("__CFBundleIdentifier"),      # set by macOS for GUI-launched apps
        "program": env("TERM_PROGRAM"),
        "iterm_session": env("ITERM_SESSION_ID", "").split(":")[-1] or None,
        "tmux": env("TMUX"),
        "tmux_pane": env("TMUX_PANE"),
        "kitty_window": env("KITTY_WINDOW_ID"),
        "kitty_listen": env("KITTY_LISTEN_ON"),
        "wezterm_pane": env("WEZTERM_PANE"),
    }
    return {k: v for k, v in ident.items() if v}


def write_atomic(path, record):
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(record, f)
    os.replace(tmp, path)


def push_iterm2(status, agent):
    session = os.environ.get("ITERM_SESSION_ID", "").split(":")[-1]
    if not session or not IT2:
        return
    try:
        subprocess.run(
            [IT2, "session", "set-status", "-s", session,
             "--status", status, "--detail", agent, "--quiet-if-unresolved"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10,
        )
    except Exception:
        pass


def main():
    agent = (sys.argv[1] if len(sys.argv) > 1 else "").lower()
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw)
    except Exception as e:
        log("PARSE ERROR %r raw=%r" % (e, raw[:200]))
        return
    event = payload.get("hook_event_name", "")
    if agent not in STATUS:
        log("unknown agent %r (event %s)" % (agent, event))
        return

    if agent == "claude" and event == "Notification":
        status = CLAUDE_NOTIFICATION.get(payload.get("notification_type", ""))
        if status is None:
            return
    elif event in STATUS[agent]:
        status = STATUS[agent][event]
    else:
        return  # event we don't care about

    pid, tty = agent_process(agent)
    key = payload.get("session_id") or str(pid)
    path = os.path.join(STORE, "%s-%s.json" % (agent, key))
    log("%s %s -> %s (pid=%s tty=%s)" % (agent, event, status, pid, tty))

    if status is None:  # SessionEnd
        try:
            os.unlink(path)
        except OSError:
            pass
        if agent == "codex":
            push_iterm2("idle", agent)
        return

    os.makedirs(STORE, exist_ok=True)
    started = time.time()
    try:
        with open(path) as f:
            started = json.load(f).get("started", started)
    except Exception:
        pass
    record = {
        "agent": agent,
        "status": status,
        "event": event,
        "cwd": payload.get("cwd") or os.getcwd(),
        "pid": pid,
        "tty": ("/dev/" + tty) if tty and tty != "??" else None,
        "session_id": payload.get("session_id"),
        "started": started,
        "updated": time.time(),
        "terminal": terminal_identity(),
    }
    try:
        write_atomic(path, record)
    except OSError as e:
        log("WRITE ERROR %r" % e)
    if agent == "codex":
        push_iterm2(status, agent)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        log("UNHANDLED %r" % e)
    sys.exit(0)
